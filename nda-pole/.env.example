# === Supabase (backend de horarios y reservas) ===
# Si dejás estas variables vacías, el sitio corre en MODO DEMO
# (datos de ejemplo en memoria, se reinician al reiniciar el server).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# === Panel de administración ===
# Contraseña que usa la dueña para entrar a /admin y cargar horarios.
ADMIN_PASSWORD=cambiame

# === Feed de calendario de la dueña ===
# Token secreto que protege el feed .ics que ella se suscribe en su celu.
# Generá algo random largo. La URL del feed será:
#   webcal://TU-DOMINIO/api/calendar/feed?token=ESTE_TOKEN
OWNER_FEED_TOKEN=cambiame-token-largo-random

# === Avisos por email (opcional, Resend) ===
# Si lo dejás vacío no se mandan mails; igual la reserva se guarda.
RESEND_API_KEY=
OWNER_EMAIL=
NOTIFY_FROM=NDA Pole <reservas@tudominio.com>

# === WhatsApp de la dueña (opcional) ===
# Sólo para mostrar el botón "Avisar por WhatsApp". Formato internacional sin +, ej 5491122223333
OWNER_WHATSAPP=
